# Copy to backend/.env for local development. Never commit the real .env.
DJANGO_DEBUG=1
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# From Google Cloud Console > APIs & Services > Credentials (see README).
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# Only for the Mac app (desktop/README.md): its Desktop OAuth client's ID, so its sign-ins are accepted.
GOOGLE_DESKTOP_CLIENT_ID=

ALLOWED_GOOGLE_DOMAIN=acts2.network
SIGNUP_RETENTION_DAYS=30
# SEATING_LOG_LEVEL=WARNING      # default INFO when DJANGO_DEBUG=1: Re-plan logs how it picks the tables

# Production only (Render sets these from render.yaml or its dashboard; leave unset locally).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DJANGO_CSP_REPORT_ONLY=1       # log CSP violations to the console instead of blocking
# DJANGO_HSTS_SECONDS=3600       # raise to 31536000 once HTTPS has run fine for a while
# DJANGO_LOG_LEVEL=WARNING       # default ERROR; WARNING also logs 4xx responses
# TRUSTED_PROXY_COUNT=           # proxies in front of the app, for the sign-in rate limit
